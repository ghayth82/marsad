# ===== مرصد التحقق: الإعدادات =====
# سكربت التشغيل ينسخ هذا الملف إلى .env في أول تشغيل، ويملأ كلمات المرور
# الفارغة بقيم عشوائية. ملف .env لا يُرفع إلى GitHub أبدًا.
# عند نقل البرنامج إلى جهاز آخر: انقل .env معه (فيه مفتاح التشفير).

# --- مكان حفظ المخرجات ---
# لا يُضبط هنا. يُغيَّر من واجهة البرنامج: الإدارة ← التخزين،
# ويُحفظ في config/storage.json. الافتراضي: مجلد data بجانب البرنامج.

# أقل مساحة فارغة (غيغابايت) قبل أن يظهر تنبيه
MARSAD_MIN_FREE_GB=20

# --- أسرار تُولَّد تلقائيًا في أول تشغيل (اتركها فارغة) ---
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
MINIO_ROOT_PASSWORD=
MARSAD_SECRET_KEY=

# --- مفاتيح المحركات (تُضاف لاحقًا، لا تُكتب في المحادثة) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
YOUTUBE_API_KEY=
TELEGRAM_BOT_TOKEN=
