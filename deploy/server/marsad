#!/usr/bin/env bash
# أداة إدارة نسخة الخادم: marsad <أمر>
set -euo pipefail
MARSAD_DIR="${MARSAD_DIR:-/srv/marsad}"
cd "$MARSAD_DIR"
dc() { docker compose "$@"; }

backup() {
  local stamp; stamp="$(date +%Y%m%d-%H%M%S)"
  dc exec -T postgres pg_dump -U marsad -d marsad -Fc -f "/backups/db/marsad-$stamp.dump"
  echo "نسخة قاعدة البيانات: $MARSAD_DIR/backups/db/marsad-$stamp.dump"
  # الإبقاء على آخر 14 نسخة
  ls -1t backups/db/*.dump 2>/dev/null | tail -n +15 | xargs -r rm -f
}

restore_test() {
  # يستعيد آخر نسخة في قاعدة مؤقتة ويتحقق من الجداول، ثم يحذف القاعدة المؤقتة فقط
  local latest; latest="$(ls -1t backups/db/*.dump 2>/dev/null | head -n1 || true)"
  [[ -n "$latest" ]] || { echo "لا توجد نسخة لاختبارها"; exit 1; }
  dc exec -T postgres sh -c "dropdb -U marsad --if-exists marsad_restore_test && createdb -U marsad marsad_restore_test \
    && pg_restore -U marsad -d marsad_restore_test --no-owner /backups/db/$(basename "$latest")"
  local n; n="$(dc exec -T postgres psql -U marsad -d marsad_restore_test -tAc "select count(*) from users")"
  dc exec -T postgres dropdb -U marsad marsad_restore_test
  echo "اختبار الاستعادة نجح: $(basename "$latest") — $n مستخدم"
}

import_bundle() {
  # ملف نقل من نسخة الجهاز: يُنسخ إلى مجلد البيانات ثم يُستورد داخل الحاوية (على نسخة جديدة قبل إنشاء أول حساب)
  local f="${1:?استعمل: marsad import ملف.marsad}"
  [[ -f "$f" ]] || { echo "الملف غير موجود: $f"; exit 1; }
  mkdir -p data/tmp && cp "$f" data/tmp/import.marsad
  read -rsp "عبارة المرور: " pass; echo
  dc exec -T -e MARSAD_TRANSFER_PASSPHRASE="$pass" api python -m marsad.transfer import /data/tmp/import.marsad
  rm -f data/tmp/import.marsad
}

export_bundle() {
  local stamp; stamp="$(date +%Y%m%d-%H%M%S)"
  read -rsp "عبارة المرور (8 أحرف على الأقل): " pass; echo
  dc exec -T -e MARSAD_TRANSFER_PASSPHRASE="$pass" api python -m marsad.transfer export "/data/exports/marsad-$stamp.marsad"
  echo "ملف النقل: $MARSAD_DIR/data/exports/marsad-$stamp.marsad"
}

case "${1:-status}" in
  status)  dc ps; dc exec -T api python -c "import urllib.request;print(urllib.request.urlopen('http://127.0.0.1:8000/api/health').read().decode())" ;;
  update)  backup; dc pull -q; dc up -d; echo "حُدّث البرنامج (أُخذت نسخة احتياطية قبل التحديث)." ;;
  backup)  backup ;;
  restore-test) restore_test ;;
  logs)    dc logs --tail=200 -f "${2:-api}" ;;
  restart) dc restart ;;
  stop)    dc stop ;;
  start)   dc up -d ;;
  cert)    dc exec -T caddy cat /data/caddy/pki/authorities/local/root.crt ;;
  import)  import_bundle "${2:-}" ;;
  export)  export_bundle ;;
  *) echo "الاستخدام: marsad {status|update|backup|restore-test|logs [خدمة]|restart|stop|start|cert|import ملف|export}"; exit 2 ;;
esac
